# Hivemind configuration. Copy to .env.local and edit. Core runs with NO config at all.

# --- general ---
HIVEMIND_PORT=3737
HIVEMIND_USER=                 # your teammate name in the feed (default: $USER / hostname)
HIVEMIND_PROJECTS_DIR=         # default: ~/.claude/projects
HIVEMIND_BACKFILL=25           # recent records per transcript to replay on startup
HIVEMIND_ACTIVE_WINDOW_MS=90000
HIVEMIND_REDACT=true           # scrub obvious secrets from event text
HIVEMIND_DEMO=false            # true => also run simulated teammates
HIVEMIND_DATA_FILE=            # default: ./data/events.jsonl (memory store persistence)

# --- backend selection ---
HIVEMIND_BUS=local             # local | kafka
HIVEMIND_STORE=memory          # memory | postgres

# --- Aiven for PostgreSQL (when HIVEMIND_STORE=postgres) ---
# Run npm i pg, then apply aiven/schema.sql to the database.
PG_CONNECTION_STRING=          # e.g. postgres://avnadmin:PWD@HOST:PORT/defaultdb?sslmode=require

# --- Aiven for Apache Kafka (when HIVEMIND_BUS=kafka) ---
# Run npm i kafkajs first.
KAFKA_BROKERS=                 # host1:port1,host2:port2
KAFKA_TOPIC=hivemind.events
KAFKA_SSL=true
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256   # or "plain"

# --- optional semantic embeddings (pgvector search). If unset, postgres store uses full-text search. ---
EMBED_URL=                     # e.g. https://api.openai.com/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=256
