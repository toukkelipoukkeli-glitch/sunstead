# ── Aiven Postgres ────────────────────────────────────────────────────────────
# From the Aiven console (project touko-1f1c) → your PG service → Connection info.
# Includes ?sslmode=require. This is the ONLY database — there is no Supabase.
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:PORT/defaultdb?sslmode=require

# ── Aiven Kafka (realtime bus) ──────────────────────────────────────────────────
# From the Aiven console → your Kafka service → Connection info (SASL/SSL).
# Leave blank to fall back to an in-process bus (single instance, dev only).
KAFKA_BROKERS=kafka-xxxx.aivencloud.com:PORT
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
# Paste the CA cert (Aiven console) as a file path or inline PEM:
KAFKA_SSL_CA_PATH=./ca.pem
KAFKA_TOPIC=pulsewall.events

# ── Embeddings (vector search) ──────────────────────────────────────────────────
# OpenAI text-embedding-3-small → vector(1536). Swap freely. Blank = search disabled.
OPENAI_API_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string
# In dev, the magic code is returned in the API response + logged (no email infra).
AUTH_DEV=true

# ── Server ───────────────────────────────────────────────────────────────────────
PORT=8787

# ── Migrator source (live-hype-wall on Lovable Cloud / Supabase) ─────────────────
# The migrator reads from here and writes to DATABASE_URL above.
# Option A: a direct source Postgres URL (if you have it).
SOURCE_DATABASE_URL=
# Option B: Supabase REST + service_role (works even on Lovable Cloud, via the perimeter key).
SOURCE_SUPABASE_URL=
SOURCE_SERVICE_ROLE_KEY=

# ── CTO agent (reads real Aiven metrics) ─────────────────────────────────────────
AIVEN_TOKEN=
AIVEN_PROJECT=touko-1f1c
AIVEN_PG_SERVICE=
