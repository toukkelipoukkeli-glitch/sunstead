# The agent's brain
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# The Aiven MCP — Claude calls aiven_* tools through this connector (the challenge).
# allow_secrets=true so the agent can read connection info during migration.
AIVEN_MCP_URL=https://mcp.aiven.live/mcp?allow_secrets=true
AIVEN_TOKEN=

# Migration target (the Aiven services the agent migrates into)
AIVEN_PROJECT=touko-1f1c
AIVEN_PG_SERVICE=pulsewall-pg
AIVEN_KAFKA_SERVICE=kafka-1a7f6796
AIVEN_KAFKA_TOPIC=pulsewall.events

# The Lovable app to migrate (a local clone of the GitHub-synced repo)
SOURCE_REPO=/tmp/live-hype-wall
