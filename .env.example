DEMO_MODE=fixture
ENABLE_LLM_SUMMARIES=false
ANTHROPIC_API_KEY=
AGENT_REASONER=anthropic

# Fresh Aiven landing-zone provisioning
AIVEN_MCP_URL=https://mcp.aiven.live/mcp?allow_secrets=true
AIVEN_MCP_TOOL_TIMEOUT_MS=90000
AIVEN_TOKEN=
AIVEN_PROJECT=
AIVEN_API_BASE=https://api.aiven.io/v1
AIVEN_CLOUD=
AIVEN_PG_PLAN=free-1-5gb
AIVEN_PROVISION_TIMEOUT_MS=600000
AIVEN_PROVISION_POLL_MS=15000
AIVEN_POSTGRES_SSL=true
AIVEN_POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Optional fresh Aiven Kafka proof path (not required for the default demo)
AIVEN_KAFKA_TOPIC=migration.events
AIVEN_KAFKA_SSL=true

# GitHub source import path
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_INSTALL_CALLBACK_URL=http://localhost:5173/setup/github/callback
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_TOKEN=

# Optional source app live mode
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_ANON_KEY=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=

# Optional source data shadow copy path
SOURCE_SUPABASE_DB_URL=
SOURCE_SUPABASE_TABLES=
SOURCE_SUPABASE_SSL=true
SOURCE_POSTGRES_URL=
SOURCE_POSTGRES_TABLES=
SOURCE_COPY_LIMIT=1000
