# Aiven
AIVEN_TOKEN=
AIVEN_PROJECT=touko-1f1c
# Target Aiven Postgres + Kafka — fill after provisioning (aiven_service_connection_info)
DATABASE_URL=
KAFKA_BROKERS=
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_SSL_CA_PATH=./ca.pem
KAFKA_TOPIC=overmind.app.outbox

# Anthropic Agent SDK (swarm). Unset → agents degrade to deterministic paths.
ANTHROPIC_API_KEY=

# ── Auth (WorkOS) — humans via AuthKit, agents via M2M self-registration ──────────────
# ABSENT WORKOS_API_KEY → MOCK MODE: humans get a dev session, agents self-register and receive
# locally-signed scoped JWTs. The whole agentic-signup demo runs end-to-end with NO WorkOS account.
# Fill these to go live (real AuthKit login + real WorkOS M2M tokens, verified offline via JWKS).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8788/api/auth/callback
WORKOS_COOKIE_PASSWORD=                 # 32+ char secret that seals the human session cookie
# Optional: shared M2M client if your SDK build can't create per-agent M2M clients programmatically.
WORKOS_M2M_CLIENT_ID=
WORKOS_M2M_CLIENT_SECRET=
# Optional overrides (else derived from WORKOS_CLIENT_ID / WorkOS defaults):
WORKOS_JWKS_URL=
WORKOS_TOKEN_URL=
# Signs mock-mode sessions + agent JWTs (and the legacy HMAC auth). Set a real secret in prod.
AUTH_SECRET=dev-secret-change-me

# Voice CTO (ElevenLabs TTS) — spoken status + weekly briefing. Unset → /api/cto/speak returns 503.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                     # optional; defaults to a built-in voice
ELEVENLABS_MODEL_ID=                     # optional; defaults to eleven_turbo_v2_5

# Source app to migrate (Lovable/Supabase)
SOURCE_REPO_DIR=../demo/live-hype-wall
SOURCE_DATABASE_URL=
SOURCE_SUPABASE_URL=
SOURCE_SERVICE_ROLE_KEY=

PORT=8788
