# Point this at your Aiven Postgres. Aiven Apps injects DATABASE_URL +
# PROJECT_CA_CERT automatically when you link the service; locally you paste it.
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:14340/defaultdb?sslmode=require
PORT=8089

# Local Postgres instead? Point DATABASE_URL at it and disable TLS:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# PGSSL=disable

# High fan-out realtime via Aiven Kafka (optional). Set REALTIME=kafka and link
# an Aiven Kafka service so these are injected:
# REALTIME=kafka
# KAFKA_BOOTSTRAP_SERVER=
# KAFKA_CA_CERT=
# KAFKA_ACCESS_CERT=
# KAFKA_ACCESS_KEY=
