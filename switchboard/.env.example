# ---- Secure front door: Connect Supabase (OAuth) ----
# The cockpit's primary path is "Connect Supabase" — no .env, no DB password. The
# source is read over the Supabase Management API with a scoped, revocable token
# that stays server-side. To enable one-click OAuth, register an OAuth app:
#   Supabase dashboard -> Organization settings -> OAuth Apps -> New application
#   Redirect URI:  http://localhost:5173/api/connect/supabase/callback
# Then paste the credentials below. WITHOUT them the cockpit still works — it falls
# back to pasting a personal access token (sbp_…) from
# https://supabase.com/dashboard/account/tokens (also scoped + revocable).
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:5173/api/connect/supabase/callback
# Optional override (defaults to https://api.supabase.com):
# SUPABASE_API_URL=https://api.supabase.com

# ---- Advanced/fallback source: a raw Supabase connection string ----
# Only used by the "Advanced: paste a .env" path. The OAuth path above never needs it.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# ---- Migration engine ----
# simulate = always works, moves no data, safe for the live demo (default)
# real     = pipes pg_dump | psql (requires postgresql client tools installed
#            AND a real Aiven target, i.e. AIVEN_TOKEN + AIVEN_PROJECT set)
MIGRATION_MODE=simulate

# ---- Target: Aiven (leave blank to simulate provisioning) ----
AIVEN_TOKEN=
AIVEN_PROJECT=
AIVEN_CLOUD=google-europe-north1
AIVEN_PLAN=hobbyist
AIVEN_API_URL=https://api.aiven.io

# Reuse a service that's already running instead of creating a new one each run
# (default on). Essential on a trial org at its concurrent-service quota, where a
# fresh create is refused on every plan. AIVEN_REUSE=0 always provisions new.
# When several services of a type exist, name the one to adopt:
AIVEN_REUSE=1
# AIVEN_PG_SERVICE=pg-xxxxxxxx
# AIVEN_VALKEY_SERVICE=sb-valkey

PORT=8787
