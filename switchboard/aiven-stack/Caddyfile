# One endpoint that speaks "Supabase" — exactly what supabase-js expects.
# /auth/v1/*  -> GoTrue      (login, signup, token refresh)
# /rest/v1/*  -> PostgREST   (your tables)
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle /health {
		respond "ok" 200
	}
	respond "supabase-on-aiven gateway" 200
}
