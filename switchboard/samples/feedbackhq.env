# FeedbackHQ — a customer feedback portal that started on Supabase and outgrew it.
# Stack: Supabase Postgres (direct) · Confluent Kafka (events) · AWS S3 (attachments).
#
# A Supabase app that bolted on a stream + object storage. Aiven verdict: Postgres
# and Kafka migrate; the S3 attachment bucket is the storage gap from the pitch.
#
# (Demo fixture — keys are fake.)

# --- Database (Supabase Postgres, direct connection) ---
DATABASE_URL=postgresql://postgres:fh_demo_pw@db.nbwxqplmtkzrabcdef.supabase.co:5432/postgres
SUPABASE_URL=https://nbwxqplmtkzrabcdef.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo.anon

# --- Event stream (Confluent Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=pkc-demo56.us-west-2.aws.confluent.cloud:9092
KAFKA_API_KEY=CONFLUENT_DEMO_KEY3
KAFKA_API_SECRET=confluent_demo_secret3

# --- Attachment storage (AWS S3) ---
S3_BUCKET=feedbackhq-attachments
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=AKIA_DEMO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=demo_secret_access_key
