# MetricHub — device telemetry ingest + analytics.
# Stack:  AWS RDS Postgres  ·  ClickHouse Cloud  ·  Confluent Kafka  ·  MongoDB Atlas  ·  S3 data lake.
# Aiven verdict:  Postgres + ClickHouse + Kafka migrate; MongoDB and S3 are the gaps.
#
# (Demo fixture — every password/key below is fake.)

# --- Metadata DB (AWS RDS Postgres) ---
DATABASE_URL=postgresql://metrichub:rds_demo_pw@metrichub-prod.cluster-abc123.us-east-1.rds.amazonaws.com:5432/metrichub

# --- Analytics warehouse (ClickHouse Cloud) ---
CLICKHOUSE_URL=https://abc123xyz.us-east-1.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_demo_pw

# --- Telemetry ingest (Confluent Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=pkc-demo34.eu-west-1.aws.confluent.cloud:9092
KAFKA_API_KEY=CONFLUENT_DEMO_KEY2

# --- Raw event store (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://metrichub:atlas_demo_pw@cluster0.abc123.mongodb.net/events?retryWrites=true&w=majority

# --- Data lake (AWS S3) ---
S3_BUCKET=metrichub-datalake
AWS_REGION=eu-west-1
