# TaskForge — a Next.js SaaS on Supabase, Prisma for data access.
# Stack: Supabase Postgres (Supavisor pooled + direct) · Upstash Redis (rate limits).
#
# The production Supabase pattern: client URL + anon + service-role key, plus a
# pooled DATABASE_URL and a DIRECT_URL for migrations — all ONE Supabase project.
# The detector dedupes those four references down to a single Postgres service.
# Aiven verdict: Postgres + Redis both migrate cleanly.
#
# (Demo fixture — keys are fake.)

# --- Supabase project (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://mtqzpwbrkxhelabcdef.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo.anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo.service

# --- Postgres (Prisma): pooled for the app, direct for migrations ---
DATABASE_URL=postgres://postgres.mtqzpwbrkxhelabcdef:tf_demo_pw@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgres://postgres.mtqzpwbrkxhelabcdef:tf_demo_pw@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=https://apn1-quick-fox-34512.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX9k_demo_token

# --- Not infrastructure (passthrough) ---
NEXTAUTH_SECRET=demo-nextauth-secret-at-least-32-chars
