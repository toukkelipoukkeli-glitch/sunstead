# ShopFlow — a headless commerce API (orders, catalog search, event stream).
# Stack:  PlanetScale MySQL  ·  Redis Cloud  ·  Elastic Cloud  ·  Confluent Kafka.
# Aiven verdict:  all four map to managed Aiven services — a clean full migration.
#
# (Demo fixture — every password/key below is fake.)

# --- Orders DB (PlanetScale MySQL) ---
MYSQL_URL=mysql://shopflow:pscale_demo_pw@aws.connect.psdb.cloud:3306/shopflow?ssl={"rejectUnauthorized":true}

# --- Cart cache (Redis Cloud) ---
REDIS_URL=redis://default:rediscloud_demo_pw@redis-15234.c92.us-east-1-3.ec2.redns.redis-cloud.com:15234

# --- Catalog search (Elastic Cloud) ---
ELASTICSEARCH_URL=https://shopflow.es.us-central1.gcp.cloud.es.io:9243
ELASTICSEARCH_API_KEY=ZWxhc3RpY19kZW1vX2FwaV9rZXk=

# --- Order events (Confluent Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=pkc-demo12.us-east-2.aws.confluent.cloud:9092
KAFKA_API_KEY=CONFLUENT_DEMO_KEY
KAFKA_API_SECRET=confluent_demo_secret

# --- Not infrastructure (passthrough) ---
STRIPE_SECRET_KEY=sk_test_demo
